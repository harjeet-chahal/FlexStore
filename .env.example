# Copy to .env and adjust. Every value here has a working default baked into
# docker-compose.yml, so an empty .env still produces a functioning cluster.

# ---------------------------------------------------------------- topology --
# Host ports. Postgres/Redis are deliberately NOT on their default host ports,
# so FlexStore does not collide with a local Postgres or Redis you already run.
GATEWAY_PORT=8080
GATEWAY_METRICS_PORT=9101
COORDINATOR_GRPC_PORT=9090
COORDINATOR_METRICS_PORT=9102
POSTGRES_PORT=5433
REDIS_PORT=6380
PROMETHEUS_PORT=9091
GRAFANA_PORT=3000

# ---------------------------------------------------------------- database --
POSTGRES_USER=flexstore
POSTGRES_PASSWORD=flexstore
POSTGRES_DB=flexstore

# --------------------------------------------------------------- durability --
# How many copies of every chunk to place.
FLEXSTORE_REPLICATION_FACTOR=3
# How many of those must acknowledge before a chunk counts as committed.
# Must be <= FLEXSTORE_REPLICATION_FACTOR. 2-of-3 tolerates one node failing
# mid-upload without failing the client's request.
FLEXSTORE_MIN_WRITE_REPLICAS=2

# ----------------------------------------------------------------- chunking --
# Unit of placement, replication and checksumming. Accepts 8MiB / 8388608 /
# 8M forms. Also bounds gateway memory: one chunk per in-flight request.
FLEXSTORE_CHUNK_SIZE=8MiB

# ------------------------------------------------------------ node capacity --
# Advertised quota per storage node. In Compose all nodes share the host disk,
# so without this they would all report identical free space and capacity-aware
# placement would have nothing to balance.
FLEXSTORE_NODE_CAPACITY_BYTES=10GiB

# -------------------------------------------------------------- node health --
FLEXSTORE_HEARTBEAT_INTERVAL=5s
# Late heartbeat -> excluded from new placements.
FLEXSTORE_SUSPECT_TIMEOUT=15s
# Very late -> replicas counted as lost for durability accounting.
FLEXSTORE_DEAD_TIMEOUT=45s

# ------------------------------------------------------------ reclamation ---
FLEXSTORE_GC_INTERVAL=20s
FLEXSTORE_UPLOAD_STALE_AFTER=30m

# -------------------------------------------------------------- placement ---
# weighted   = capacity/load-aware weighted random (spreads load, non-repeatable)
# rendezvous = highest-random-weight hashing (deterministic, minimal movement
#              when a node joins or leaves)
FLEXSTORE_PLACEMENT_STRATEGY=weighted

# ------------------------------------------------------------ self-healing --
# The repair manager re-replicates chunks that fall below the replication
# factor. Turning it off leaves under-replication visible in metrics but
# unfixed -- useful when demonstrating the difference.
FLEXSTORE_REPAIR_ENABLED=true
# Total concurrent chunk copies across the cluster.
FLEXSTORE_REPAIR_WORKERS=4
# Concurrent repairs allowed to target ONE node. This is the replication-storm
# guard: without it, losing a node points every repair at whichever node looks
# emptiest and buries it.
FLEXSTORE_REPAIR_MAX_PER_NODE=2
FLEXSTORE_REPAIR_SCAN_INTERVAL=5s
FLEXSTORE_REPAIR_SCAN_BATCH=200
FLEXSTORE_REPAIR_JOB_TIMEOUT=120s
# Must exceed the job timeout, or a worker's own job could be stolen mid-copy.
FLEXSTORE_REPAIR_LEASE=5m
FLEXSTORE_REPAIR_MAX_ATTEMPTS=6
FLEXSTORE_REPAIR_BASE_BACKOFF=2s
FLEXSTORE_REPAIR_MAX_BACKOFF=2m
FLEXSTORE_REPAIR_HISTORY_TTL=6h

# Reconciliation verifies a returning node's files before trusting them again.
FLEXSTORE_RECONCILE_ENABLED=true
FLEXSTORE_RECONCILE_INTERVAL=5s
FLEXSTORE_RECONCILE_PAGE_SIZE=500
FLEXSTORE_RECONCILE_TIMEOUT=10m
FLEXSTORE_RECONCILE_LEASE=15m
# Re-hash every chunk on a returning node. Thorough but expensive; reads verify
# checksums regardless, so turning this off trades scrub depth, not safety.
FLEXSTORE_RECONCILE_VERIFY_CHECKSUMS=true

# How often the denormalised replica counters are recomputed to catch drift.
FLEXSTORE_DURABILITY_AUDIT_INTERVAL=10m

# --------------------------------------------------------------- logging ----
# debug | info | warn | error
FLEXSTORE_LOG_LEVEL=info
# json | text
FLEXSTORE_LOG_FORMAT=json

# ------------------------------------------------------------ size limits ---
# Largest object the gateway will accept. Enforced on the wire, and pre-checked
# against Content-Length so an oversized upload is refused before a byte is read.
FLEXSTORE_MAX_OBJECT_SIZE=5TiB

# --------------------------------------------------------------- grafana ----
# These are local-development defaults that mirror docker-compose.yml. Grafana
# is bound to 127.0.0.1, so they are not reachable off this machine -- but they
# are still defaults, and a real deployment must replace them.
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Anonymous read-only viewing. Convenient for a local demo (open :3000 and the
# dashboards are just there), off by default because "convenient for a demo" and
# "safe by default" point in opposite directions.
GRAFANA_ANONYMOUS=false
